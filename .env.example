# Loopback-only development credentials. Use separate credentials outside local development.
POSTGRES_DB=campaigniq
POSTGRES_USER=campaigniq
POSTGRES_PASSWORD=campaigniq_dev
POSTGRES_PORT=5433
DATABASE_URL=postgresql+psycopg://campaigniq:campaigniq_dev@127.0.0.1:5433/campaigniq
FRONTEND_ORIGIN=http://localhost:5173
# Vite proxies /api to this server during development and local preview.
API_PROXY_TARGET=http://127.0.0.1:8000

# Deterministic detection uses at least seven full days of maturation.
DETECTION_MATURATION_DAYS=7

# Optional AI Analyst. Set the model to a Structured Outputs-capable model in your project.
AI_ANALYSIS_ENABLED=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
AI_REQUEST_LIMIT_PER_HOUR=8
AI_PROVIDER_MAX_ATTEMPTS=2
